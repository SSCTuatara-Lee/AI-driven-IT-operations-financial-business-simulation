# Commit this template only. Keep real values in the ignored .env file.
# Run scripts/init_config.py to generate local database passwords.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
APP_PORT=8001
# Optional shared token for this single-operator lab.
APP_TOKEN=
# Compatible provider API base URL (often ending in /v1).
# Do not include /chat/completions or /embeddings here.
MODEL_BASE_URL=
# Keep this key in .env or a deployment secret, never in source code.
MODEL_API_KEY=
# Use the provider's exact API model identifier, not its display name.
CHAT_MODEL=
# Optional. Currently shares MODEL_BASE_URL and MODEL_API_KEY with chat.
EMBEDDING_MODEL=
